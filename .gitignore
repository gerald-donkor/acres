# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
client/node_modules/
server/node_modules/
packages/*/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
server/coverage/

# next.js
/client/.next/
/client/out/

# production
/client/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and client/.env.example is the opt-in: it documents
# NEXT_PUBLIC_SITE_URL and carries no secret (client/lib/site.ts,
# docs/polish.md).
!client/.env.example
# ...and server/.env.example is the second opt-in: it documents PORT,
# CLIENT_ORIGIN, DATABASE_URL and the session/CSRF variables with
# placeholders only, and carries no secret (docs/backend.md).
!server/.env.example
# ...and /.env.example is the third opt-in: it documents the disposable
# local-dev passwords docker-compose.yml reads, and carries no real secret
# (docs/backend.md).
!/.env.example

# build output
server/dist/
packages/shared/dist/

# prisma's generated client — regenerated by `npm run build`/`typecheck`
server/src/generated/

# vercel
.vercel

# reference material from other projects — not part of this repo's contract
/ref

# typescript
*.tsbuildinfo
client/next-env.d.ts
