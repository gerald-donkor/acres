{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "ACRES_API_ORIGIN"
        }
      ]
    },
    "api": {
      "root": "server",
      "framework": "nestjs",
      "functions": {
        "src/main.ts": {
          "regions": ["iad1"],
          "maxDuration": 30
        },
        "src/vercel/jobs.function.ts": {
          "regions": ["iad1"],
          "maxDuration": 60,
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "acres-jobs",
              "retryAfterSeconds": 5
            }
          ]
        },
        "src/vercel/dispatch.function.ts": {
          "regions": ["iad1"],
          "maxDuration": 60
        }
      }
    },
    "jobs": {
      "root": "server",
      "entrypoint": "src/vercel/jobs.function.ts",
      "functions": {
        "src/vercel/jobs.function.ts": {
          "regions": ["iad1"],
          "maxDuration": 60,
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "acres-jobs",
              "retryAfterSeconds": 5
            }
          ]
        }
      }
    }
  },
  "crons": [
    {
      "path": "/cron/dispatch",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/cron/dispatch",
      "destination": {
        "service": "api",
        "path": "/src/vercel/dispatch.function.ts"
      }
    },
    {
      "source": "/_next/image",
      "destination": "/_vercel/image"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ],
  "images": {
    "domains": [],
    "sizes": [
      640, 750, 828, 1080, 1200, 1920, 2048, 3840, 32, 48, 64, 96, 128, 256, 384
    ],
    "qualities": [75, 100],
    "remotePatterns": [],
    "localPatterns": [
      {
        "pathname": "^/assets/ui/landing/.*$",
        "search": ""
      }
    ],
    "minimumCacheTTL": 14400,
    "formats": ["image/webp"],
    "dangerouslyAllowSVG": false,
    "contentSecurityPolicy": "script-src 'none'; frame-src 'none'; sandbox;",
    "contentDispositionType": "attachment"
  }
}
