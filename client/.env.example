# The deployment's public origin, used for metadataBase, the canonical URL, the
# Open Graph and Twitter image URLs, the sitemap and robots.txt. Falls back to
# http://localhost:3000 when unset, so local development needs no .env file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only origin used by the Next API bridge at /api/v1/*.
# Browser code must call same-origin /api/v1/* instead of reading this value.
ACRES_API_ORIGIN=http://localhost:3001
