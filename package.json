{
  "name": "acres",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "packages/shared"
  ],
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "@nestjs/platform-express": {
      "multer": "2.4.0"
    }
  },
  "scripts": {
    "prepare": "npm run build --workspace=@acres/shared",
    "dev": "npm run dev --workspace=@acres/client",
    "dev:client": "npm run dev --workspace=@acres/client",
    "dev:server": "npm run start:dev --workspace=@acres/server",
    "build": "npm run build --workspace=@acres/shared && npm run build --workspace=@acres/client && npm run build --workspace=@acres/server",
    "build:shared": "npm run build --workspace=@acres/shared",
    "build:client": "npm run build --workspace=@acres/client",
    "build:server": "npm run build --workspace=@acres/server",
    "contracts:generate": "npm run contracts:generate --workspace=@acres/server",
    "contracts:check": "npm run contracts:check --workspace=@acres/server",
    "start": "npm run start --workspace=@acres/client",
    "start:server": "npm run start --workspace=@acres/server",
    "start:worker": "npm run start:worker --workspace=@acres/server",
    "lint": "npm run lint --workspace=@acres/client && npm run lint --workspace=@acres/shared && npm run lint --workspace=@acres/server",
    "typecheck": "npm run build --workspace=@acres/shared && npm run typecheck --workspace=@acres/shared && npm run typecheck --workspace=@acres/client && npm run typecheck --workspace=@acres/server",
    "test:server": "npm run test:e2e --workspace=@acres/server",
    "test:client:e2e": "npm run test:e2e --workspace=@acres/client",
    "analytics:plans": "npm run analytics:plans --workspace=@acres/server",
    "geography:plans": "npm run geography:plans --workspace=@acres/server",
    "geography:provider:acquire": "npm run geography:provider:acquire --workspace=@acres/server --",
    "geography:provider:review": "npm run geography:provider:review --workspace=@acres/server --",
    "geography:provider:import": "npm run geography:provider:import --workspace=@acres/server --",
    "ops:templates": "scripts/ops/check-production-templates.sh",
    "ops:templates-test": "node --test scripts/ops/check-smtp-template-keys.spec.js scripts/ops/check-proxy-environment.spec.js scripts/ops/check-application-environment.spec.js scripts/ops/check-garage-metrics.spec.js scripts/ops/check-production-templates.spec.js scripts/ops/check-production-templates-shell.spec.js",
    "ops:templates-shell-test": "node --test scripts/ops/check-production-templates-shell.spec.js",
    "ops:scan-secrets": "scripts/ops/scan-secrets.sh",
    "ops:scan-secrets-test": "node --test scripts/ops/scan-secrets.spec.js",
    "ops:docker-runtime": "scripts/ops/check-docker-runtime.sh",
    "ops:docker-runtime-test": "node --test scripts/ops/check-docker-runtime.spec.js",
    "ops:audit": "scripts/ops/audit-dependencies.sh",
    "ops:audit-test": "node --test scripts/ops/audit-dependencies.spec.js",
    "ops:readiness-test": "node --test scripts/ops/check-launch-readiness.spec.js",
    "ops:reconcile-test": "node --test scripts/ops/reconcile-storage-objects.spec.js",
    "ops:backup": "scripts/ops/backup-postgres.sh",
    "ops:backup-test": "node --test scripts/ops/backup-postgres.spec.js",
    "ops:restore": "scripts/ops/restore-postgres.sh",
    "ops:restore-test": "node --test scripts/ops/restore-postgres.spec.js",
    "ops:restore-drill": "scripts/ops/run-restore-drill.sh",
    "ops:restore-drill-test": "node --test scripts/ops/run-restore-drill.spec.js",
    "ops:reconcile-storage": "node scripts/ops/reconcile-storage-objects.js",
    "ops:caddy-test": "node --test scripts/ops/verify-caddy-routing.spec.js",
    "ops:caddy-drill": "node --test scripts/ops/verify-caddy-routing.spec.js && node scripts/ops/verify-caddy-routing.js",
    "ops:deployment-drill": "scripts/ops/run-deployment-drill.sh --dry-run",
    "ops:deployment-test": "node --test scripts/ops/run-deployment-drill.spec.js",
    "ops:volume-test": "node --test scripts/ops/verify-volume-encryption.spec.js",
    "ops:volume-drill": "node scripts/ops/verify-volume-encryption.js",
    "ops:rotation-drill": "scripts/ops/run-secret-rotation-drill.sh",
    "ops:rotation-test": "node --test scripts/ops/run-secret-rotation-drill.spec.js",
    "ops:sbom": "node scripts/ops/generate-sbom.js --verify-licenses",
    "ops:sbom-test": "node --test scripts/ops/generate-sbom.spec.js",
    "ops:sast": "node scripts/ops/run-sast-scan.js",
    "ops:sast-test": "node --test scripts/ops/run-sast-scan.spec.js",
    "ops:container-test": "node --test scripts/ops/verify-container-security.spec.js",
    "ops:container-security": "node scripts/ops/verify-container-security.js",
    "ops:release-images-test": "node --test scripts/ops/check-release-images.spec.js",
    "ops:capacity-test": "node --test scripts/ops/verify-capacity-load.spec.js",
    "ops:capacity-drill": "node scripts/ops/verify-capacity-load.js",
    "ops:alert-test": "node --test scripts/ops/verify-alert-rules.spec.js",
    "ops:alert-drill": "node scripts/ops/verify-alert-rules.js",
    "ops:dos-drill": "bash scripts/ops/run-dos-resilience-drill.sh",
    "ops:capacity-alerting-drill": "bash scripts/ops/run-capacity-alerting-drill.sh",
    "ops:launch-drill": "bash scripts/ops/run-launch-drills.sh --dry-run",
    "ops:launch-drill-test": "node --test scripts/ops/run-launch-drills.spec.js scripts/ops/assemble-launch-dossier.spec.js",
    "ops:launch-readiness-test": "node --test scripts/ops/launch-readiness.spec.js",
    "ops:check": "npm run ops:templates && npm run ops:templates-test && npm run ops:templates-shell-test && npm run ops:release-images-test && npm run ops:scan-secrets && npm run ops:scan-secrets-test && npm run ops:docker-runtime && npm run ops:docker-runtime-test && npm run ops:static-integrity-test && npm run ops:audit && npm run ops:audit-test && npm run ops:readiness-schema-test && npm run ops:readiness-test && npm run ops:launch-readiness-test && npm run ops:reconcile-test && npm run ops:backup-test && npm run ops:restore-test && npm run ops:restore-drill-test && npm run ops:caddy-test && npm run ops:deployment-test && npm run ops:volume-test && npm run ops:rotation-test && npm run ops:sbom-test && npm run ops:sbom && npm run ops:sast-test && npm run ops:sast && npm run ops:container-test && npm run ops:container-security && npm run ops:capacity-test && npm run ops:alert-test && npm run ops:dos-test && npm run ops:capacity-alerting-test && npm run ops:launch-drill-test",
    "ops:launch-readiness": "scripts/ops/launch-readiness.sh",
    "db:up": "docker compose up -d postgres",
    "deps:up": "docker compose up -d postgres valkey garage clamav mailpit",
    "garage:setup": "scripts/garage/setup-local.sh",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "ops:readiness-schema-test": "node --test scripts/ops/check-readiness-schema.spec.js",
    "ops:dos-test": "node --test scripts/ops/run-dos-resilience-drill.spec.js scripts/ops/launch-target-evidence.spec.js",
    "ops:capacity-alerting-test": "node --test scripts/ops/run-capacity-alerting-drill.spec.js",
    "ops:static-integrity-test": "node --test scripts/ops/run-static-integrity-checks.spec.js"
  },
  "devDependencies": {
    "ajv": "6.15.0"
  }
}
