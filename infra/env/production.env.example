# Acres production environment template.
# Replace every __REQUIRED_*__ value through the operator-approved secret
# injection mechanism. scripts/ops/check-production-templates.sh rejects these
# sentinels for launch use.

# Non-secret routing/config.
NODE_ENV=production
ACRES_PRODUCTION_DOMAIN=__REQUIRED_PRODUCTION_DOMAIN__
ACRES_TLS_CONTACT_EMAIL=__REQUIRED_TLS_CONTACT_EMAIL__
CLIENT_ORIGIN=https://__REQUIRED_PRODUCTION_DOMAIN__
ACRES_CADDY_DATA_MOUNT=/__REQUIRED_OPERATOR_CADDY_DATA_MOUNT__
ACRES_CADDY_CONFIG_MOUNT=/__REQUIRED_OPERATOR_CADDY_CONFIG_MOUNT__
ACRES_POSTGRES_ENCRYPTED_MOUNT=/__REQUIRED_OPERATOR_POSTGRES_ENCRYPTED_MOUNT__
ACRES_VALKEY_ENCRYPTED_MOUNT=/__REQUIRED_OPERATOR_VALKEY_ENCRYPTED_MOUNT__
ACRES_GARAGE_META_ENCRYPTED_MOUNT=/__REQUIRED_OPERATOR_GARAGE_META_ENCRYPTED_MOUNT__
ACRES_GARAGE_DATA_ENCRYPTED_MOUNT=/__REQUIRED_OPERATOR_GARAGE_DATA_ENCRYPTED_MOUNT__
ACRES_CLAMAV_ENCRYPTED_MOUNT=/__REQUIRED_OPERATOR_CLAMAV_ENCRYPTED_MOUNT__
ACRES_PROMETHEUS_ENCRYPTED_MOUNT=/__REQUIRED_OPERATOR_PROMETHEUS_ENCRYPTED_MOUNT__
ACRES_GRAFANA_ENCRYPTED_MOUNT=/__REQUIRED_OPERATOR_GRAFANA_ENCRYPTED_MOUNT__
ACRES_MAX_REQUEST_BODY=__REQUIRED_MAX_REQUEST_BODY__
ACRES_API_READ_TIMEOUT=__REQUIRED_API_READ_TIMEOUT__
ACRES_API_WRITE_TIMEOUT=__REQUIRED_API_WRITE_TIMEOUT__
ACRES_API_DIAL_TIMEOUT=__REQUIRED_API_DIAL_TIMEOUT__
ACRES_NEXT_READ_TIMEOUT=__REQUIRED_NEXT_READ_TIMEOUT__
ACRES_NEXT_WRITE_TIMEOUT=__REQUIRED_NEXT_WRITE_TIMEOUT__
ACRES_NEXT_DIAL_TIMEOUT=__REQUIRED_NEXT_DIAL_TIMEOUT__
ACRES_OBJECT_READ_TIMEOUT=__REQUIRED_OBJECT_READ_TIMEOUT__
ACRES_OBJECT_WRITE_TIMEOUT=__REQUIRED_OBJECT_WRITE_TIMEOUT__
ACRES_OBJECT_DIAL_TIMEOUT=__REQUIRED_OBJECT_DIAL_TIMEOUT__
ACRES_HSTS_MAX_AGE=__REQUIRED_HSTS_MAX_AGE_AFTER_APPROVAL__
PORT=3001
NEXT_PORT=3000

# Secret values, injected at runtime. Never prefix these with NEXT_PUBLIC_.
POSTGRES_SUPERUSER_PASSWORD=__REQUIRED_SECRET_POSTGRES_SUPERUSER_PASSWORD__
ACRES_MIGRATOR_PASSWORD=__REQUIRED_SECRET_ACRES_MIGRATOR_PASSWORD__
ACRES_APP_PASSWORD=__REQUIRED_SECRET_ACRES_APP_PASSWORD__
DATABASE_URL=postgresql://acres_app:__REQUIRED_SECRET_ACRES_APP_PASSWORD__@postgres:5432/acres?schema=public
DATABASE_MIGRATION_URL=postgresql://acres_migrator:__REQUIRED_SECRET_ACRES_MIGRATOR_PASSWORD__@postgres:5432/acres?schema=public
SESSION_SECRET=__REQUIRED_SECRET_SESSION_SECRET_32_BYTES_MINIMUM__
VALKEY_PASSWORD=__REQUIRED_SECRET_VALKEY_PASSWORD__
VALKEY_URL=redis://:__REQUIRED_SECRET_VALKEY_PASSWORD__@valkey:6379/0
STORAGE_ACCESS_KEY_ID=__REQUIRED_SECRET_STORAGE_ACCESS_KEY_ID__
STORAGE_SECRET_ACCESS_KEY=__REQUIRED_SECRET_STORAGE_SECRET_ACCESS_KEY__
SMTP_HOST=__REQUIRED_SMTP_HOST__
SMTP_PORT=__REQUIRED_SMTP_PORT__
SMTP_USERNAME=__REQUIRED_SECRET_SMTP_USERNAME__
SMTP_PASSWORD=__REQUIRED_SECRET_SMTP_PASSWORD__
PROMETHEUS_RETENTION=__REQUIRED_OPERATOR_PROMETHEUS_RETENTION__
GRAFANA_ADMIN_USER=__REQUIRED_OPERATOR_GRAFANA_ADMIN_USER__
GRAFANA_ADMIN_PASSWORD=__REQUIRED_SECRET_GRAFANA_ADMIN_PASSWORD__

# Product and operations values that remain operator-owned.
SLO_AVAILABILITY_TARGET=__REQUIRED_OPERATOR_SLO_AVAILABILITY_TARGET__
RPO_TARGET=__REQUIRED_OPERATOR_RPO_TARGET__
RTO_TARGET=__REQUIRED_OPERATOR_RTO_TARGET__
BACKUP_DESTINATION=__REQUIRED_OPERATOR_BACKUP_DESTINATION__
RETENTION_POLICY_REF=__REQUIRED_OPERATOR_RETENTION_POLICY_REF__
ALERT_OWNER_PRIMARY=__REQUIRED_OPERATOR_ALERT_OWNER_PRIMARY__
ALERT_OWNER_SECONDARY=__REQUIRED_OPERATOR_ALERT_OWNER_SECONDARY__
CAPACITY_TARGET_REF=__REQUIRED_OPERATOR_CAPACITY_TARGET_REF__
PRODUCTION_INTROSPECTION_POLICY=__REQUIRED_OPERATOR_INTROSPECTION_POLICY__
PRODUCTION_VOLUME_ENCRYPTION=__REQUIRED_OPERATOR_ENCRYPTED_MOUNT_DECLARATION__
PRODUCTION_KEY_RECOVERY_OWNER=__REQUIRED_OPERATOR_KEY_RECOVERY_OWNER__

# Existing application settings, to be reviewed before launch.
SESSION_COOKIE_NAME=acres_session
SESSION_TTL_DAYS=__REQUIRED_SESSION_TTL_DAYS__
CSRF_COOKIE_NAME=acres_csrf
SCHEDULER_ENABLED=false
RATE_LIMIT_TTL_MS=__REQUIRED_RATE_LIMIT_TTL_MS__
RATE_LIMIT_DEFAULT_LIMIT=__REQUIRED_RATE_LIMIT_DEFAULT_LIMIT__
RATE_LIMIT_STRICT_LIMIT=__REQUIRED_RATE_LIMIT_STRICT_LIMIT__
TENANCY_ENABLED=true
INVITATION_TTL_HOURS=__REQUIRED_INVITATION_TTL_HOURS__
ACCOUNT_TOKEN_TTL_MINUTES=__REQUIRED_ACCOUNT_TOKEN_TTL_MINUTES__
GRAPHQL_MAX_BYTES=__REQUIRED_GRAPHQL_MAX_BYTES__
GRAPHQL_MAX_DEPTH=__REQUIRED_GRAPHQL_MAX_DEPTH__
GRAPHQL_MAX_ALIASES=__REQUIRED_GRAPHQL_MAX_ALIASES__
GRAPHQL_MAX_COST=__REQUIRED_GRAPHQL_MAX_COST__
GRAPHQL_MAX_FIRST=__REQUIRED_GRAPHQL_MAX_FIRST__
GRAPHQL_MAX_NODES=__REQUIRED_GRAPHQL_MAX_NODES__
GRAPHQL_TIMEOUT_MS=__REQUIRED_GRAPHQL_TIMEOUT_MS__
IDEMPOTENCY_TTL_HOURS=__REQUIRED_IDEMPOTENCY_TTL_HOURS__
QUEUE_NAME=acres-ingestion
QUEUE_PREFIX=acres
QUEUE_DEFAULT_ATTEMPTS=__REQUIRED_QUEUE_DEFAULT_ATTEMPTS__
QUEUE_BACKOFF_MS=__REQUIRED_QUEUE_BACKOFF_MS__
QUEUE_SHUTDOWN_MS=__REQUIRED_QUEUE_SHUTDOWN_MS__
STORAGE_ENDPOINT=https://__REQUIRED_PRODUCTION_DOMAIN__
STORAGE_REGION=garage
STORAGE_BUCKET=acres-quarantine
STORAGE_FORCE_PATH_STYLE=true
PRESIGNED_UPLOAD_TTL_SECONDS=__REQUIRED_PRESIGNED_UPLOAD_TTL_SECONDS__
ACCEPTED_DOWNLOAD_TTL_SECONDS=__REQUIRED_ACCEPTED_DOWNLOAD_TTL_SECONDS__
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_MS=__REQUIRED_CLAMAV_SCAN_TIMEOUT_MS__
UPLOAD_MAX_BYTES=__REQUIRED_UPLOAD_MAX_BYTES__
UPLOAD_ACCEPTED_MEDIA_TYPES=__REQUIRED_UPLOAD_ACCEPTED_MEDIA_TYPES__
UPLOAD_STALE_MINUTES=__REQUIRED_UPLOAD_STALE_MINUTES__
UPLOAD_CLEANUP_INTERVAL_MS=__REQUIRED_UPLOAD_CLEANUP_INTERVAL_MS__
PARSER_MAX_ROWS=__REQUIRED_PARSER_MAX_ROWS__
PARSER_MAX_COLUMNS=__REQUIRED_PARSER_MAX_COLUMNS__
PARSER_MAX_CELL_CHARS=__REQUIRED_PARSER_MAX_CELL_CHARS__
PARSER_MAX_SAMPLE_ROWS=__REQUIRED_PARSER_MAX_SAMPLE_ROWS__
PARSER_MAX_GEOJSON_FEATURES=__REQUIRED_PARSER_MAX_GEOJSON_FEATURES__
PARSER_MAX_GEOJSON_COORDINATES=__REQUIRED_PARSER_MAX_GEOJSON_COORDINATES__
OUTBOX_CLAIM_BATCH_SIZE=__REQUIRED_OUTBOX_CLAIM_BATCH_SIZE__
OUTBOX_CLAIM_LEASE_MS=__REQUIRED_OUTBOX_CLAIM_LEASE_MS__
OUTBOX_MAX_ATTEMPTS=__REQUIRED_OUTBOX_MAX_ATTEMPTS__
