{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAST Triage Policy Schema",
  "type": "object",
  "required": ["version", "suppressions"],
  "properties": {
    "version": { "type": "string" },
    "suppressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule_id", "path", "severity", "rationale", "approved_by", "approved_date", "expires_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^SUP-[0-9]{3,}$" },
          "rule_id": { "type": "string", "pattern": "^SAST-[0-9]{2}$" },
          "path": { "type": "string" },
          "severity": { "type": "string", "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"] },
          "rationale": { "type": "string" },
          "approved_by": { "type": "string" },
          "approved_date": { "type": "string" },
          "expires_at": { "type": "string" },
          "line": { "type": "integer" },
          "lines": { "type": "array", "items": { "type": "integer" } },
          "snippet": { "type": "string" }
        }
      }
    }
  }
}
