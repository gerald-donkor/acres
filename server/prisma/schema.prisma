// Acres data layer. PostgreSQL in every environment; see docs/backend.md.
//
// No seed data lives here. The regional figures in the design comps are
// illustration, and inventing them as fixtures would make them look real.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// A first-party email/password account.
model Account {
  id                    String        @id @default(uuid(7))
  email                 String        @unique
  passwordHash          String
  displayName           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  sessions              Session[]
  memberships           Membership[]
  invitationsIssued     Invitation[]  @relation("InvitationIssuer")
  invitationsAccepted   Invitation[]  @relation("InvitationAcceptor")
  accountTokens         AccountToken[]
  auditEventsAuthored   AuditEvent[]  @relation("AuditActor")
  idempotencyRecords    IdempotencyRecord[]
  uploads               Upload[]
  ownedDatasets         Dataset[]      @relation("DatasetOwner")
  columnMappings         ColumnMapping[]
  ingestionRuns          IngestionRun[]
  dashboardViews         DashboardView[]
}

/// An opaque, server-revocable browser session. Only the hash is stored.
model Session {
  id        String    @id @default(uuid(7))
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
}

/// A geography Acres reports on.
model Region {
  id          String           @id @default(uuid(7))
  slug        String           @unique
  name        String
  countryCode String?
  summary     String?
  parentId    String?
  level       String           @default("legacy")
  regionType  String           @default("legacy")
  retiredAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  parent      Region?          @relation("RegionHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Region[]         @relation("RegionHierarchy")
  metrics     RegionalMetric[]
  reports     InsightReport[]
  codes       RegionCode[]
  aliases     RegionAlias[]
  geometries  RegionGeometry[]
  observations MetricObservation[]
  metricAggregates MetricAggregate[]

  @@index([parentId, level])
  @@index([countryCode, level])
}

/// One measured figure for one region over one period.
model RegionalMetric {
  id          String    @id @default(uuid(7))
  regionId    String
  key         String
  label       String
  value       Float
  unit        String?
  periodStart DateTime?
  periodEnd   DateTime?
  source      String?
  createdAt   DateTime  @default(now())
  region      Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@index([regionId, key])
}

/// A written insight over one region, or over the whole dataset.
model InsightReport {
  id        String              @id @default(uuid(7))
  regionId  String?
  title     String
  summary   String
  status    InsightReportStatus @default(draft)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  region    Region?             @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([regionId, status])
}

enum InsightReportStatus {
  draft
  published
  archived
}

/// A lead captured from a public form.
model ContactSubmission {
  id           String   @id @default(uuid(7))
  name         String
  email        String
  organization String?
  message      String
  source       String
  createdAt    DateTime @default(now())

  @@index([email])
}

/// Bookkeeping for scheduled work.
model JobRun {
  id         String       @id @default(uuid(7))
  jobName    String
  status     JobRunStatus
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  message    String?

  @@index([jobName, status, startedAt])
}

enum JobRunStatus {
  running
  succeeded
  failed
}

/// The tenant and primary authorization boundary.
model Organization {
  id          String       @id @default(uuid(7))
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  invitations Invitation[]
  auditEvents AuditEvent[]
  idempotencyRecords IdempotencyRecord[]
  storedObjects StoredObject[]
  uploads Upload[]
  outboxEvents OutboxEvent[]
  durableJobs DurableJob[]
  jobDeadLetters JobDeadLetter[]
  jobProgressEvents JobProgressEvent[]
  datasets Dataset[]
  datasetVersions DatasetVersion[]
  columnMappings ColumnMapping[]
  ingestionRuns IngestionRun[]
  validationIssues ValidationIssue[]
  stagedSourceSummaries StagedSourceSummary[]
  metricDefinitions MetricDefinition[]
  observations MetricObservation[]
  observationQualities ObservationQuality[]
  metricAggregates MetricAggregate[]
  aggregateLineage MetricAggregateLineage[]
  dashboardViews DashboardView[]
}

/// An account's organization-local role. Revoked rows remain as provenance.
model Membership {
  id             String           @id @default(uuid(7))
  organizationId String
  accountId      String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  revokedAt      DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account        Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([organizationId, accountId])
  @@index([accountId, revokedAt, organizationId])
  @@index([organizationId, revokedAt, role])
}

/// A single-use invitation. Only the token hash is stored.
model Invitation {
  id                 String           @id @default(uuid(7))
  organizationId     String
  email              String
  role               OrganizationRole
  tokenHash          String           @unique
  invitedByAccountId String
  expiresAt          DateTime
  createdAt          DateTime         @default(now())
  acceptedAt         DateTime?
  acceptedByAccountId String?
  revokedAt          DateTime?
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy          Account          @relation("InvitationIssuer", fields: [invitedByAccountId], references: [id], onDelete: Restrict)
  acceptedBy         Account?         @relation("InvitationAcceptor", fields: [acceptedByAccountId], references: [id], onDelete: Restrict)

  @@index([organizationId, revokedAt, acceptedAt, createdAt])
  @@index([expiresAt])
}

/// Identity-owned single-use token storage for recovery and verification.
model AccountToken {
  id         String              @id @default(uuid(7))
  accountId  String
  purpose    AccountTokenPurpose
  tokenHash  String              @unique
  expiresAt  DateTime
  createdAt  DateTime            @default(now())
  consumedAt DateTime?
  revokedAt  DateTime?
  account    Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, revokedAt, consumedAt, expiresAt])
  @@index([expiresAt])
}

/// Append-oriented organization security and governance history.
model AuditEvent {
  id              String       @id @default(uuid(7))
  organizationId  String
  actorAccountId  String?
  action          AuditAction
  targetType      String
  targetId        String?
  details         Json?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor           Account?     @relation("AuditActor", fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@index([organizationId, action, createdAt])
  @@index([actorAccountId, createdAt])
}

/// Replay-safe storage for duplicate-producing organization commands.
model IdempotencyRecord {
  id              String            @id @default(uuid(7))
  keyDigest       String
  accountId       String
  organizationId  String?
  operation       String
  requestHash     String
  state           IdempotencyState
  responseStatus  Int?
  responseBody    Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  expiresAt       DateTime
  account         Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([accountId, organizationId, operation, expiresAt])
  @@index([expiresAt])
}

enum OrganizationRole {
  owner
  admin
  analyst
  viewer
}

enum AccountTokenPurpose {
  password_recovery
  email_verification
}

enum AuditAction {
  organization_created
  organization_updated
  invitation_issued
  invitation_revoked
  invitation_accepted
  membership_role_changed
  membership_revoked
  ownership_transferred
}

enum IdempotencyState {
  in_progress
  succeeded
}

/// Opaque metadata for an object held outside PostgreSQL.
model StoredObject {
  id                 String            @id @default(uuid(7))
  organizationId     String
  bucket             String
  objectKey          String            @unique
  originalFilename   String
  mediaType          String
  detectedMediaType  String?
  byteCount          BigInt?
  checksumAlgorithm  String
  checksumHex        String?
  state              StoredObjectState @default(pending_upload)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploads            Upload[]
  datasetVersions    DatasetVersion[]

  @@unique([organizationId, id])
  @@index([organizationId, state, createdAt])
  @@index([organizationId, checksumHex])
}

model Upload {
  id                   String        @id @default(uuid(7))
  organizationId        String
  actorAccountId        String
  storedObjectId        String
  state                UploadState   @default(pending_upload)
  declaredFilename      String
  declaredMediaType     String
  declaredByteCount     BigInt
  completedByteCount    BigInt?
  checksumAlgorithm     String
  checksumHex           String?
  scanStatus            ScanStatus?
  scanResult            String?
  failureCode           String?
  failureMessage        String?
  progressStage         String       @default("created")
  progressPercent       Int          @default(0)
  version               Int          @default(1)
  presignedUploadExpiresAt DateTime
  expiresAt             DateTime
  completedAt           DateTime?
  cancelledAt           DateTime?
  acceptedAt            DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor                 Account      @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)
  storedObject          StoredObject @relation(fields: [storedObjectId], references: [id], onDelete: Restrict)
  progressEvents        JobProgressEvent[]
  datasetVersions       DatasetVersion[]
  columnMappings        ColumnMapping[]
  ingestionRuns         IngestionRun[]

  @@unique([organizationId, id])
  @@index([organizationId, state, updatedAt])
  @@index([organizationId, actorAccountId, createdAt])
  @@index([expiresAt, state])
}

model OutboxEvent {
  id              String          @id @default(uuid(7))
  organizationId  String?
  eventType       String
  aggregateType   String
  aggregateId     String
  aggregateVersion Int
  payload         Json
  state           OutboxState     @default(pending)
  lockedBy        String?
  lockedUntil     DateTime?
  attempts        Int             @default(0)
  maxAttempts     Int             @default(5)
  nextAttemptAt   DateTime        @default(now())
  lastErrorCode   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  dispatchedAt    DateTime?
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([eventType, aggregateType, aggregateId, aggregateVersion])
  @@index([state, nextAttemptAt, lockedUntil])
  @@index([organizationId, state, createdAt])
}

model DurableJob {
  id             String           @id @default(uuid(7))
  organizationId String?
  uploadId       String?
  jobType        String
  deterministicKey String         @unique
  state          DurableJobState  @default(queued)
  attempts       Int              @default(0)
  maxAttempts    Int              @default(5)
  lastErrorCode  String?
  lastErrorMessage String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deadLetters    JobDeadLetter[]
  progressEvents JobProgressEvent[]

  @@index([organizationId, state, updatedAt])
  @@index([state, updatedAt])
}

model JobProgressEvent {
  id              String        @id @default(uuid(7))
  organizationId  String
  uploadId        String
  durableJobId    String?
  stage           String
  percent         Int
  message         String?
  createdAt       DateTime      @default(now())
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  upload          Upload        @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  durableJob      DurableJob?   @relation(fields: [durableJobId], references: [id], onDelete: SetNull)

  @@index([organizationId, uploadId, createdAt])
}

model JobDeadLetter {
  id              String       @id @default(uuid(7))
  organizationId  String?
  durableJobId    String?
  outboxEventId   String?
  reasonCode      String
  reasonMessage   String
  payload         Json?
  createdAt       DateTime     @default(now())
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  durableJob      DurableJob?  @relation(fields: [durableJobId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

enum StoredObjectState {
  pending_upload
  quarantined
  accepted
  rejected
  deleted
}

enum UploadState {
  pending_upload
  completed
  scanning
  accepted
  rejected
  cancelled
  expired
}

enum ScanStatus {
  pending
  clean
  infected
  failed
}

enum OutboxState {
  pending
  dispatched
  retrying
  dead_lettered
}

enum DurableJobState {
  queued
  running
  succeeded
  failed
  cancelled
  dead_lettered
}

model RegionSource {
  id                  String           @id @default(uuid(7))
  name                String
  provider            String
  codeSystem          String
  sourceVersion       String
  sourceDate          DateTime?
  license             String?
  provenanceUrl       String?
  redistributionNotes String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  codes               RegionCode[]
  aliases             RegionAlias[]
  geometries          RegionGeometry[]

  @@unique([provider, codeSystem, sourceVersion])
}

model RegionCode {
  id          String       @id @default(uuid(7))
  regionId    String
  sourceId    String
  codeSystem  String
  code        String
  normalized  String
  createdAt   DateTime     @default(now())
  region      Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  source      RegionSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, codeSystem, normalized])
  @@index([regionId, sourceId])
}

model RegionAlias {
  id         String       @id @default(uuid(7))
  regionId   String
  sourceId   String?
  locale     String?
  alias      String
  normalized String
  createdAt  DateTime     @default(now())
  region     Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  source     RegionSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([normalized, locale])
  @@index([regionId])
}

model RegionGeometry {
  id              String       @id @default(uuid(7))
  regionId        String
  sourceId        String
  srid            Int          @default(4326)
  geometryType    String
  isValid         Boolean      @default(false)
  sourcePrecision String?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  region          Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  source          RegionSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([regionId, sourceId])
}

model Dataset {
  id             String           @id @default(uuid(7))
  organizationId String
  ownerAccountId String
  name           String
  description    String?
  sourceMetadata Json?
  state          DatasetState     @default(draft)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner          Account          @relation("DatasetOwner", fields: [ownerAccountId], references: [id], onDelete: Restrict)
  versions       DatasetVersion[]
  mappings       ColumnMapping[]
  ingestionRuns  IngestionRun[]
  metricDefinitions MetricDefinition[]

  @@unique([organizationId, id])
  @@index([organizationId, state, updatedAt])
}

model DatasetVersion {
  id               String                   @id @default(uuid(7))
  organizationId   String
  datasetId        String
  versionNumber    Int
  sourceUploadId   String
  storedObjectId   String
  mappingId        String
  publicationStatus DatasetPublicationStatus @default(published)
  checksumHex      String?
  sourceSummary    Json
  publishedAt      DateTime                 @default(now())
  createdAt        DateTime                 @default(now())
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dataset          Dataset                  @relation(fields: [organizationId, datasetId], references: [organizationId, id], onDelete: Restrict)
  sourceUpload     Upload                   @relation(fields: [organizationId, sourceUploadId], references: [organizationId, id], onDelete: Restrict)
  storedObject     StoredObject             @relation(fields: [organizationId, storedObjectId], references: [organizationId, id], onDelete: Restrict)
  mapping          ColumnMapping            @relation(fields: [organizationId, mappingId], references: [organizationId, id], onDelete: Restrict)
  ingestionRuns    IngestionRun[]
  observations     MetricObservation[]
  metricAggregates MetricAggregate[]
  aggregateLineage MetricAggregateLineage[]

  @@unique([organizationId, id])
  @@unique([datasetId, versionNumber])
  @@unique([organizationId, datasetId, sourceUploadId, mappingId])
  @@index([organizationId, datasetId, publishedAt])
}

model ColumnMapping {
  id               String                  @id @default(uuid(7))
  organizationId   String
  datasetId        String
  uploadId         String
  createdByAccountId String
  versionNumber    Int
  mapping           Json
  validationStatus  MappingValidationStatus @default(pending)
  createdAt         DateTime                @default(now())
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dataset           Dataset                 @relation(fields: [organizationId, datasetId], references: [organizationId, id], onDelete: Restrict)
  upload            Upload                  @relation(fields: [organizationId, uploadId], references: [organizationId, id], onDelete: Restrict)
  createdBy         Account                 @relation(fields: [createdByAccountId], references: [id], onDelete: Restrict)
  datasetVersions   DatasetVersion[]
  ingestionRuns     IngestionRun[]

  @@unique([organizationId, id])
  @@unique([datasetId, versionNumber])
  @@index([organizationId, datasetId, createdAt])
}

model IngestionRun {
  id               String              @id @default(uuid(7))
  organizationId   String
  datasetId        String
  uploadId         String
  mappingId        String
  datasetVersionId String?
  actorAccountId   String
  deterministicKey String
  state            IngestionRunState   @default(queued)
  stage            IngestionRunStage   @default(inspect)
  progressPercent  Int                 @default(0)
  attempts         Int                 @default(0)
  failureCode      String?
  failureMessage   String?
  cancelledAt      DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dataset          Dataset             @relation(fields: [organizationId, datasetId], references: [organizationId, id], onDelete: Restrict)
  upload           Upload              @relation(fields: [organizationId, uploadId], references: [organizationId, id], onDelete: Restrict)
  mapping          ColumnMapping       @relation(fields: [organizationId, mappingId], references: [organizationId, id], onDelete: Restrict)
  datasetVersion   DatasetVersion?     @relation(fields: [organizationId, datasetVersionId], references: [organizationId, id], onDelete: Restrict)
  actor            Account             @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)
  issues           ValidationIssue[]
  stagedSummaries  StagedSourceSummary[]

  @@unique([organizationId, id])
  @@unique([organizationId, deterministicKey])
  @@index([organizationId, datasetId, createdAt])
  @@index([organizationId, state, updatedAt])
}

model ValidationIssue {
  id             String                  @id @default(uuid(7))
  organizationId String
  ingestionRunId String
  severity       ValidationIssueSeverity
  code           String
  message        String
  rowNumber      Int?
  rowRange       String?
  columnKey      String?
  regionRef      String?
  details        Json?
  createdAt      DateTime                @default(now())
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ingestionRun   IngestionRun            @relation(fields: [organizationId, ingestionRunId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, ingestionRunId, severity, createdAt])
  @@index([organizationId, code, createdAt])
}

model StagedSourceSummary {
  id             String       @id @default(uuid(7))
  organizationId String
  ingestionRunId String
  rowCount       Int
  columnCount    Int
  sampleRows     Json
  columnKeys     Json
  sourceKind     String
  checksumHex    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ingestionRun   IngestionRun @relation(fields: [organizationId, ingestionRunId], references: [organizationId, id], onDelete: Cascade)

  @@unique([ingestionRunId])
  @@index([organizationId, createdAt])
}

enum DatasetState {
  draft
  active
  archived
}

enum DatasetPublicationStatus {
  published
}

enum MappingValidationStatus {
  pending
  valid
  invalid
}

enum IngestionRunState {
  queued
  running
  validation_failed
  published
  failed
  cancelling
  cancelled
}

enum IngestionRunStage {
  inspect
  parse
  map
  validate
  publish
  complete
}

enum ValidationIssueSeverity {
  info
  warning
  error
}

model MetricDefinition {
  id                 String                 @id @default(uuid(7))
  organizationId     String
  datasetId          String?
  key                String
  label              String
  description        String?
  valueType          MetricValueType
  canonicalUnit      String
  allowedAggregation MetricAggregationType
  calculationVersion String
  status             MetricDefinitionStatus @default(active)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dataset            Dataset?               @relation(fields: [organizationId, datasetId], references: [organizationId, id], onDelete: Restrict)
  observations       MetricObservation[]
  aggregates         MetricAggregate[]

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@index([organizationId, status, key])
  @@index([organizationId, datasetId])
}

model MetricObservation {
  id                 String                   @id @default(uuid(7))
  organizationId     String
  datasetVersionId   String
  regionId           String
  metricDefinitionId String
  periodStart        DateTime
  periodEnd          DateTime
  periodLabel        String?
  numericValue       Decimal?                 @db.Decimal(26, 6)
  textValue          String?
  booleanValue       Boolean?
  unit               String
  dimensionHash      String
  dimensions         Json
  sourceRowNumber    Int?
  sourceReference    Json?
  createdAt          DateTime                 @default(now())
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  datasetVersion     DatasetVersion           @relation(fields: [organizationId, datasetVersionId], references: [organizationId, id], onDelete: Restrict)
  region             Region                   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  metricDefinition   MetricDefinition         @relation(fields: [organizationId, metricDefinitionId], references: [organizationId, id], onDelete: Restrict)
  qualities          ObservationQuality[]
  aggregateLineage   MetricAggregateLineage[]

  @@unique([organizationId, id])
  @@unique([organizationId, datasetVersionId, metricDefinitionId, regionId, periodStart, periodEnd, dimensionHash, sourceRowNumber])
  @@index([organizationId, metricDefinitionId, regionId, periodStart, periodEnd])
  @@index([organizationId, datasetVersionId])
  @@index([organizationId, dimensionHash])
}

model ObservationQuality {
  id             String                     @id @default(uuid(7))
  organizationId String
  observationId  String
  severity       ObservationQualitySeverity
  state          ObservationQualityState
  code           String
  message        String
  details        Json?
  createdAt      DateTime                   @default(now())
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  observation    MetricObservation          @relation(fields: [organizationId, observationId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, observationId, severity, createdAt])
  @@index([organizationId, code, createdAt])
}

model MetricAggregate {
  id                 String                   @id @default(uuid(7))
  organizationId     String
  datasetVersionId   String
  metricDefinitionId String
  regionId           String
  periodStart        DateTime
  periodEnd          DateTime
  dimensionHash      String
  dimensions         Json
  aggregateType      MetricAggregationType
  numericValue       Decimal?                 @db.Decimal(26, 6)
  textValue          String?
  booleanValue       Boolean?
  unit               String
  calculationVersion String
  observationCount   Int
  qualitySummary     Json
  datasetVersionIds  Json
  createdAt          DateTime                 @default(now())
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  datasetVersion     DatasetVersion           @relation(fields: [organizationId, datasetVersionId], references: [organizationId, id], onDelete: Restrict)
  metricDefinition   MetricDefinition         @relation(fields: [organizationId, metricDefinitionId], references: [organizationId, id], onDelete: Restrict)
  region             Region                   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  lineage            MetricAggregateLineage[]

  @@unique([organizationId, id])
  @@unique([organizationId, datasetVersionId, metricDefinitionId, regionId, periodStart, periodEnd, dimensionHash, aggregateType, calculationVersion])
  @@index([organizationId, datasetVersionId])
  @@index([organizationId, metricDefinitionId, regionId, periodStart, periodEnd])
  @@index([organizationId, dimensionHash])
}

model MetricAggregateLineage {
  id               String            @id @default(uuid(7))
  organizationId   String
  aggregateId      String
  observationId    String
  datasetVersionId String
  createdAt        DateTime          @default(now())
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  aggregate        MetricAggregate   @relation(fields: [organizationId, aggregateId], references: [organizationId, id], onDelete: Cascade)
  observation      MetricObservation @relation(fields: [organizationId, observationId], references: [organizationId, id], onDelete: Cascade)
  datasetVersion   DatasetVersion    @relation(fields: [organizationId, datasetVersionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, aggregateId, observationId])
  @@index([organizationId, observationId])
  @@index([organizationId, datasetVersionId])
}

model DashboardView {
  id             String              @id @default(uuid(7))
  organizationId String
  ownerAccountId String
  name           String
  description    String?
  filters        Json
  presentation   Json
  status         DashboardViewStatus @default(active)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner          Account             @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, ownerAccountId, updatedAt])
}

enum DashboardViewStatus {
  active
  archived
}

enum MetricValueType {
  numeric
  text
  boolean
}

enum MetricAggregationType {
  sum
  avg
  min
  max
  count
  latest
}

enum MetricDefinitionStatus {
  active
  archived
}

enum ObservationQualitySeverity {
  info
  warning
  error
}

enum ObservationQualityState {
  valid
  coerced
  missing
  invalid
  duplicate
  low_confidence
}
