# Acres API — copy to server/.env and fill in. No secret belongs in this file.

# HTTP port. 3001 keeps the API clear of the Next.js client on 3000.
PORT=3001

# Browser origin allowed to send credentialed requests (CORS + CSRF).
CLIENT_ORIGIN=http://localhost:3000

# Non-owner runtime credentials. The running API only ever needs CRUD, never
# DDL — see docs/backend.md for the acres_app role's exact privileges.
DATABASE_URL=postgresql://acres_app:acres_app_dev_password@localhost:5432/acres?schema=public

# Owner/migration credentials. Only `prisma migrate` / `prisma db push` /
# `prisma migrate status` read this — never the running API. Falls back to
# DATABASE_URL if unset.
DATABASE_MIGRATION_URL=postgresql://acres_migrator:acres_migrator_dev_password@localhost:5432/acres?schema=public

# Session cookie carrying the opaque session token.
SESSION_COOKIE_NAME=acres_session
SESSION_TTL_DAYS=30

# HMAC secret for the double-submit CSRF token. Generate per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-32-bytes-minimum-in-real-environments

# Cookie name the CSRF token is mirrored into.
CSRF_COOKIE_NAME=acres_csrf

# Set to false to disable the in-process scheduler. Exactly one instance in
# production may run it; see docs/backend.md.
SCHEDULER_ENABLED=true

# Rate-limit window, in milliseconds.
RATE_LIMIT_TTL_MS=60000

# Requests per rate-limit window for ordinary routes, per IP.
RATE_LIMIT_DEFAULT_LIMIT=120

# Requests per rate-limit window for auth/contact mutations, per IP.
RATE_LIMIT_STRICT_LIMIT=10

# Development examples only. Production must choose and set token lifetimes,
# review existing accounts, and bootstrap organizations before enabling this.
TENANCY_ENABLED=false
INVITATION_TTL_HOURS=24
ACCOUNT_TOKEN_TTL_MINUTES=30

# Provisional GraphQL abuse ceilings from the Phase 4 schema fixtures. These
# are not product SLOs or supported tenant-scale commitments.
GRAPHQL_MAX_BYTES=12000
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_ALIASES=12
GRAPHQL_MAX_COST=250
GRAPHQL_MAX_FIRST=50
GRAPHQL_MAX_NODES=250
GRAPHQL_TIMEOUT_MS=5000

# Replay retention for duplicate-producing organization commands. Production
# must choose this deliberately with operational cleanup in a later phase.
IDEMPOTENCY_TTL_HOURS=24

# Local development queue. Production must inject a rotated password/URL from a
# secret store and keep Valkey private.
VALKEY_URL=redis://:acres_valkey_dev_password@localhost:6379/0
QUEUE_NAME=acres-ingestion
QUEUE_PREFIX=acres
QUEUE_DEFAULT_ATTEMPTS=5
QUEUE_BACKOFF_MS=30000
QUEUE_SHUTDOWN_MS=15000

# Local Garage/S3-compatible quarantine bucket. These are development examples;
# production credentials must be created per environment and never sent to the
# browser. The browser receives only short-lived presigned object URLs.
STORAGE_ENDPOINT=http://localhost:3900
STORAGE_REGION=garage
STORAGE_BUCKET=acres-quarantine
STORAGE_ACCESS_KEY_ID=change-me-local-garage-access-key
STORAGE_SECRET_ACCESS_KEY=change-me-local-garage-secret-key
STORAGE_FORCE_PATH_STYLE=true
PRESIGNED_UPLOAD_TTL_SECONDS=900
ACCEPTED_DOWNLOAD_TTL_SECONDS=300

# ClamAV listens only on the local/private dependency network in production.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_MS=10000

# Temporary development safety limits, not customer-facing product policy.
UPLOAD_MAX_BYTES=52428800
UPLOAD_ACCEPTED_MEDIA_TYPES=text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/geo+json,application/json
UPLOAD_STALE_MINUTES=60
UPLOAD_CLEANUP_INTERVAL_MS=300000
PARSER_MAX_ROWS=10000
PARSER_MAX_COLUMNS=200
PARSER_MAX_CELL_CHARS=2000
PARSER_MAX_SAMPLE_ROWS=5
PARSER_MAX_GEOJSON_FEATURES=2500
PARSER_MAX_GEOJSON_COORDINATES=100000
OUTBOX_CLAIM_BATCH_SIZE=25
OUTBOX_CLAIM_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=5

# node environment: development | test | production
NODE_ENV=development
